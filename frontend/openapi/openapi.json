{
  "openapi": "3.0.1",
  "info": { "title": "EcoGuard API", "version": "0.1.0" },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": { "200": { "description": "Liveness" } }
      }
    },
    "/districts": {
      "get": {
        "operationId": "listDistricts",
        "responses": {
          "200": {
            "description": "Districts",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeatureCollection" }
              }
            }
          }
        }
      }
    },
    "/districts/{code}": {
      "get": {
        "operationId": "getDistrict",
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "One district" }, "404": { "description": "Missing" } }
      }
    },
    "/risk-config": {
      "get": {
        "operationId": "riskConfig",
        "responses": {
          "200": {
            "description": "Confirmed weights",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/RiskConfig" } }
            }
          }
        }
      }
    },
    "/scores/summary": {
      "get": {
        "operationId": "scoreSummary",
        "responses": {
          "200": {
            "description": "Latest broadcast scores and the daily series",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CityScores" } }
            }
          }
        }
      }
    },
    "/analyst/questions": {
      "post": {
        "operationId": "askAnalyst",
        "responses": { "200": { "description": "Answer" }, "503": { "description": "Model unavailable" } }
      }
    }
  },
  "components": {
    "schemas": {
      "FeatureCollection": {
        "type": "object",
        "required": ["type", "features"],
        "properties": {
          "type": { "type": "string" },
          "features": { "type": "array", "items": { "$ref": "#/components/schemas/Feature" } }
        }
      },
      "Feature": {
        "type": "object",
        "required": ["type", "properties"],
        "properties": {
          "type": { "type": "string" },
          "properties": { "$ref": "#/components/schemas/DistrictProperties" },
          "geometry": { "type": "object", "additionalProperties": true }
        }
      },
      "DistrictProperties": {
        "type": "object",
        "required": ["code", "name", "source"],
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "abbreviation": { "type": "string", "nullable": true },
          "subprefectureId": { "type": "integer", "nullable": true },
          "areaKm2": { "type": "number", "nullable": true },
          "source": { "type": "string" },
          "sourceUpdatedAt": { "type": "string", "format": "date-time", "nullable": true },
          "score": { "$ref": "#/components/schemas/ScoreSnapshot" }
        }
      },
      "ScoreSnapshot": {
        "type": "object",
        "properties": {
          "scoreDate": { "type": "string", "format": "date" },
          "environmental": { "type": "number", "nullable": true },
          "health": { "type": "number", "nullable": true },
          "social": { "type": "number", "nullable": true },
          "overall": { "type": "number", "nullable": true },
          "heat": { "type": "number", "nullable": true },
          "rain": { "type": "number", "nullable": true },
          "dengue": { "type": "number", "nullable": true },
          "environmentalCoverage": { "type": "number", "nullable": true },
          "healthCoverage": { "type": "number", "nullable": true },
          "environmentalClass": { "type": "string" },
          "healthClass": { "type": "string" },
          "socialClass": { "type": "string" },
          "overallClass": { "type": "string" },
          "environmentalComplete": { "type": "boolean" },
          "healthComplete": { "type": "boolean" },
          "socialComplete": { "type": "boolean" },
          "grainNote": { "type": "string", "nullable": true }
        }
      },
      "SeriesPoint": {
        "type": "object",
        "required": ["scoreDate"],
        "properties": {
          "scoreDate": { "type": "string", "format": "date" },
          "heat": { "type": "number", "nullable": true },
          "rain": { "type": "number", "nullable": true },
          "dengue": { "type": "number", "nullable": true },
          "environmental": { "type": "number", "nullable": true },
          "health": { "type": "number", "nullable": true }
        }
      },
      "CityScores": {
        "type": "object",
        "required": ["series"],
        "properties": {
          "latest": { "$ref": "#/components/schemas/ScoreSnapshot" },
          "series": { "type": "array", "items": { "$ref": "#/components/schemas/SeriesPoint" } }
        }
      },
      "RiskConfig": {
        "type": "object",
        "required": ["environmental", "health", "social", "status"],
        "properties": {
          "environmental": { "type": "number" },
          "health": { "type": "number" },
          "social": { "type": "number" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
