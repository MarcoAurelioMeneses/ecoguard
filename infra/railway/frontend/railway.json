{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/frontend/Dockerfile",
    "watchPatterns": ["frontend/**", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "infra/railway/frontend/**"]
  },
  "deploy": {
    "startCommand": "node frontend/server.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
