{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/api/Dockerfile",
    "watchPatterns": ["backend/**", "db/migration/**", "infra/railway/api/**"]
  },
  "deploy": {
    "startCommand": "java -jar /app/ecoguard-api.jar",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1,
    "overlapSeconds": 10,
    "drainingSeconds": 15
  }
}
