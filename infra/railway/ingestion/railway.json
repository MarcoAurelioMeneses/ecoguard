{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/railway/ingestion/Dockerfile",
    "watchPatterns": ["backend/**", "db/migration/**", "infra/railway/ingestion/**"]
  },
  "deploy": {
    "startCommand": "java -jar /app/ecoguard-ingestion.jar --ecoguard.job=backfill --spring.main.web-application-type=none --spring.flyway.enabled=false",
    "cronSchedule": "0 9 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
