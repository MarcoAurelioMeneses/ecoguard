# Copy to .env and fill in locally. Never commit .env.
# All secrets stay in the environment. This file has empty placeholders only.

ECOGUARD_ENVIRONMENT=local

# Local docker-compose Postgres. The password below is for local development only.
ECOGUARD_DATABASE_URL=postgresql://ecoguard:ecoguard@localhost:5432/ecoguard

ECOGUARD_HTTP_TIMEOUT_SECONDS=30

# InfoDengue is a public API (no key). 3550308 is the IBGE code for São Paulo.
ECOGUARD_INFODENGUE_GEOCODE=3550308
ECOGUARD_INFODENGUE_DISEASE=dengue
# Leave the year window empty to fetch the previous calendar year and the current one.
ECOGUARD_INFODENGUE_YEAR_START=
ECOGUARD_INFODENGUE_YEAR_END=

# Open-Meteo free tier: non-commercial use, CC BY 4.0, no API key.
# A commercial deployment must set the customer host and a key. Do not put a real key here.
ECOGUARD_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
ECOGUARD_OPEN_METEO_API_KEY=
ECOGUARD_OPEN_METEO_LATITUDE=-23.5505
ECOGUARD_OPEN_METEO_LONGITUDE=-46.6333
ECOGUARD_OPEN_METEO_TIMEZONE=America/Sao_Paulo
ECOGUARD_OPEN_METEO_FORECAST_DAYS=7
ECOGUARD_OPEN_METEO_LOCATION_ID=sp-city-reference

# Planned sources. Unused by this foundation. Leave blank.
ECOGUARD_INMET_TOKEN=
ECOGUARD_CETESB_USERNAME=
ECOGUARD_CETESB_PASSWORD=

# Planned model and observability. Unused by this foundation. Leave blank.
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ecoguard-api
